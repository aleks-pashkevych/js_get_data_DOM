var population = 0;
populationTag.forEach(function(el) {
    var tmp = el.textContent.split(',');
    var countryPopulation = Number(tmp.join(''));
    population += countryPopulation;
});
var countries = document.querySelectorAll('li');
var numberOfCountries = countries.length;
var average = population / numberOfCountries;
var totalTag = document.querySelector('.total-population');
var averagePopulationTag = document.querySelector('.average-population');
var outputTotal = new Intl.NumberFormat('en-US').format(population);
